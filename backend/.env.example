# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="YOUR_APP_URL"

# MongoDB connection string
MONGODB_URI="YOUR_MONGODB_URI"

# AI Agent API Keys (Accessed via env variables)
# OpenAI / ChatGPT API Key (Required for ChatGPT agents: focus agent, task hint agent)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# NVIDIA AI Foundation Models API Key (Required for NVIDIA Insights agent)
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"

# Anthropic / Claude API Key (Required for Claude intervention agent, task generator agent)
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
