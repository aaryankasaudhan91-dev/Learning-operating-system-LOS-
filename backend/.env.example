PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/synapse
FIREBASE_PROJECT_ID=your-firebase-project
# GOOGLE_APPLICATION_CREDENTIALS points to a private credential file outside the frontend.
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,https://localhost,capacitor://localhost,null
REALTIME_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,https://localhost,capacitor://localhost,null
# Explicit provider selection; no automatic paid-provider fallback.
AI_PROVIDER=
AI_MODEL=
AI_DAILY_REQUEST_LIMIT=20
GROQ_API_KEY=

# Production transport; terminate TLS at your reverse proxy, restrict access to Node.
PUBLIC_SITE_URL=
TRUST_PROXY=loopback
# Cloudflare Turnstile secret is server-only; hostname must match the configured widget.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
ANALYTICS_ENABLED=false

FIREBASE_WEB_API_KEY=
# Generate a private random 32-byte base64 key on the server. Keep stable across restarts.
AUTH_SESSION_ENCRYPTION_KEY=
