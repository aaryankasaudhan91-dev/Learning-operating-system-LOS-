# Backend only. Copy to backend/.env; never put these credentials in VITE_*.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Persistent MongoDB, e.g. mongodb://127.0.0.1:27017/synapse
# Or mongodb+srv://<username>:<password>@<cluster>/synapse
# No temporary fallback or automatic demo records.
MONGODB_URI=

# Firebase Console -> Project settings. Enable Email/Password authentication.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# Absolute path to private service-account JSON outside public folders.
# Managed hosting can instead use workload identity/application-default credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Generated privately by npm run setup:env. Keep stable across restarts.
AUTH_SESSION_ENCRYPTION_KEY=

# Turnstile secret is private; public site key belongs in website .env.local.
# Exact hostname for the real widget; the widget uses action "signup".
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# Production requires your final HTTPS website origin.
PUBLIC_SITE_URL=
# Trusted local proxy range: loopback, linklocal, or uniquelocal.
# Leave blank for direct local development.
TRUST_PROXY=
# Relative to the backend working directory in production.
WEB_PORTAL_DIR=../frontends/website/dist

# Replace development origins with exact origins used by your deployment.
# "null" is the packaged Electron file origin; bearer authentication remains required.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,https://localhost,capacitor://localhost,null
REALTIME_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,https://localhost,capacitor://localhost,null

# Optional aggregate analytics. The website sends only after visitor opt-in.
ANALYTICS_ENABLED=false

# Optional live AI: choose one supported provider and an available model.
# Provider identifiers: groq, openai, nvidia, anthropic, gemini.
# No automatic paid fallback. Core learning is available without AI.
AI_PROVIDER=
AI_MODEL=
AI_DAILY_REQUEST_LIMIT=20
GROQ_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
