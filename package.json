{
  "name": "los-app",
  "private": true,
  "workspaces": [
    "backend",
    "packages/learning-ui",
    "frontends/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "server": "npm run dev -w backend",
    "server:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend && node desktop/build.mjs",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w @synapse/website && npm run typecheck -w @synapse/mobile && tsc -p backend/tsconfig.json --noEmit && tsc -p desktop/tsconfig.json",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run build && electron-builder",
    "mobile:sync": "npm run build -w @synapse/mobile && npm exec -w @synapse/mobile -- cap sync android",
    "web:dev": "npm run dev -w @synapse/website",
    "web:build": "npm run build -w @synapse/website",
    "test:realtime": "tsx --test backend/tests/realtime.test.ts",
    "test:backend": "tsx --test backend/tests/*.test.ts",
    "dev:all": "concurrently -k -n API,APP,WEB,MOBILE \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run web:dev\" \"npm run dev -w @synapse/mobile\"",
    "desktop:dev": "concurrently -k -n API,APP,ELECTRON \"npm run dev:backend\" \"npm run dev:frontend\" \"node desktop/dev.mjs\"",
    "check:ready": "node scripts/check-readiness.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "test:assistant": "tsx --test backend/tests/assistant.test.ts",
    "assistant:setup": "python scripts/setup-assistant.py",
    "test:assistant:electron": "node desktop/test-assistant.mjs",
    "test:assistant:native": "python scripts/test-assistant-native.py",
    "test:assistant:python": "python -m unittest discover -s native/needle -p test_worker.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  },
  "main": "desktop-app/main.cjs",
  "build": {
    "appId": "com.synapse.los",
    "productName": "Synapse",
    "directories": {
      "output": "release",
      "app": "desktop-app"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "native-manifest.json",
      "package.json",
      "icon.png",
      "frontend-dist/**",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/native/win32-x64",
        "to": "native/win32-x64",
        "filter": [
          "needle/**",
          "licenses/**"
        ]
      }
    ]
  },
  "version": "0.2.0",
  "description": "Synapse Learner Operating System",
  "overrides": {
    "rollup": "4.64.5"
  }
}
