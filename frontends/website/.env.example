# Public website build-time settings. Every VITE_* value is visible to visitors.
# Copy to frontends/website/.env.local. Restart/rebuild after changes.

# Empty uses the local proxy or same-origin production backend.
VITE_BACKEND_URL=
# Final HTTPS website origin, matching backend PUBLIC_SITE_URL.
# Blank keeps indexing disabled.
VITE_SITE_URL=

# Public Turnstile site key. Matching secret stays in the backend.
VITE_TURNSTILE_SITE_KEY=

# Complete these when the operator and contact are final.
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=

# Optional bottom walkthrough: HTTPS YouTube watch/share URL.
# This public URL becomes visible when loaded by the visitor.
VITE_INFO_YOUTUBE_URL=

# Optional external HTTPS Windows installer URL.
# Blank uses the local /downloads/latest.json manifest.
VITE_WINDOWS_DOWNLOAD_URL=

# Enable backend ANALYTICS_ENABLED too if wanted.
# Visitor consent still controls whether analytics is sent.
VITE_ANALYTICS_ENABLED=false
