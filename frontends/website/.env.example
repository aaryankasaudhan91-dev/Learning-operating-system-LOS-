# Frontend Environment Variables Template
# Copy this file to .env and provide your environment credentials.
# All keys, endpoints, and credentials must be accessed strictly through env variables.

VITE_BACKEND_URL="http://localhost:3000"

# Firebase Client Configuration (Loaded strictly through ENV)

# Public browser configuration only. Never put private keys here.
VITE_INFO_YOUTUBE_URL=
VITE_SITE_URL=
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_TURNSTILE_SITE_KEY=
VITE_ANALYTICS_ENABLED=false
