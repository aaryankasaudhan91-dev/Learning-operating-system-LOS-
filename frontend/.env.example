# Frontend Environment Variables Template
# Copy this file to .env and provide your environment credentials.
# All keys, endpoints, and credentials must be accessed strictly through env variables.

VITE_BACKEND_URL="http://localhost:3000"

# Firebase Client Configuration (Loaded strictly through ENV)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
