# Public settings shared by desktop/mobile. Copy to packages/learning-ui/.env.
# No private Firebase Admin, database or provider credentials belong here.

# Local browser preview can leave this blank for Vite's API proxy.
# Packaged desktop/mobile releases require your reachable HTTPS API origin.
VITE_BACKEND_URL=

# Public HTTPS website for creating a Synapse ID.
VITE_SITE_URL=
